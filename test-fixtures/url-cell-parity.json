{
  "cases": [
    {"name": "empty cell", "cell": "", "href": ""},
    {"name": "bare http URL", "cell": "https://jobs.example.com/1", "href": "https://jobs.example.com/1"},
    {"name": "bare https URL", "cell": "https://boards.greenhouse.io/acme/jobs/9?gh_jid=123", "href": "https://boards.greenhouse.io/acme/jobs/9?gh_jid=123"},
    {"name": "linked with host label", "cell": "[jobs.example.com](https://jobs.example.com/1)", "href": "https://jobs.example.com/1"},
